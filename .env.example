# --- Tavily (https://app.tavily.com) ---
TAVILY_API_KEY=tvly-xxxxxxxx
TAVILY_DEPTH=advanced         # basic = 1 credit, advanced = 2 credits (8,000 hackathon credits is plenty)

# --- Bifrost gateway (run: npx -y @maximhq/bifrost  -> UI at http://localhost:8080) ---
# Add your provider key(s) in the Bifrost web UI, NOT here.
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=dummy

# Models use Bifrost's "provider/model" format
EXTRACT_MODEL=openai/gpt-4o-mini
JUDGE_MODEL=openai/gpt-4o
# Optional: comma-separated provider/model fallbacks Bifrost tries in order if the primary fails
# e.g. FALLBACK_MODELS=anthropic/claude-sonnet-4-6
FALLBACK_MODELS=
